# ==============================================================================
# BIOSFERA – Consultoria Ambiental, Lda.
# Hostinger / LiteSpeed Browser Caching & Static Content Optimization
# Reduces Node.js (lsnode) load to prevent 503 Service Unavailable errors
# ==============================================================================

FileETag MTime Size

# ------------------------------------------------------------------------------
# 1. LiteSpeed Cache (Safe rules for Express + SPA)
# ------------------------------------------------------------------------------
<IfModule LiteSpeed>
  CacheLookup on
  <IfModule mod_rewrite.c>
    RewriteEngine On
    # Never cache API endpoints, uploads, or restricted admin portal
    RewriteCond %{REQUEST_URI} ^/(api|uploads|acesso-restrito)(/|$) [NC]
    RewriteRule .* - [E=Cache-Control:no-cache]
    # Never cache non-GET/HEAD requests
    RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$
    RewriteRule .* - [E=Cache-Control:no-cache]
  </IfModule>
</IfModule>

# ------------------------------------------------------------------------------
# 2. Browser Expiration Rules (mod_expires)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"

  # HTML & dynamic data should always revalidate
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"

  # Favicons & icons
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 month"

  # Images & media
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType video/webm "access plus 1 month"

  # CSS & JavaScript (Vite content-hashed bundles)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"

  # Web fonts
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# ------------------------------------------------------------------------------
# 3. Cache-Control & Security Headers (mod_headers)
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header unset X-Powered-By
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Immutable caching for Vite hashed JS/CSS & fonts
  <FilesMatch "\.(js|mjs|css|woff2|woff|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Long-lived browser caching with stale-while-revalidate for images & icons
  <FilesMatch "\.(ico|png|jpe?g|webp|avif|gif|svg|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>

  # Always revalidate HTML entrypoints so new deployments appear immediately
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------------------------
# 4. Gzip / Deflate Compression (mod_deflate)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/otf
</IfModule>
