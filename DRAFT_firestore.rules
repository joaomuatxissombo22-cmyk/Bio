rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedEmail() && request.auth.token.email == 'joaomuatxissombo22@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() ||
        (isVerifiedEmail() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidEmail(val) {
      return val is string && val.size() >= 5 && val.size() <= 140 && val.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    function isValidMediaPath(val) {
      return val is string && val.size() >= 1 && val.size() <= 500 &&
        (val.matches('^https://.*') || val.matches('^/.*'));
    }

    function isValidStringList(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || arr[0] is string);
    }

    // --- Validation Blueprints ---

    function isValidSiteSettings(data) {
      return data.keys().hasAll([
          'heroTitle', 'heroSubtitle', 'institutionalTitle', 'institutionalDescription',
          'yearsExperience', 'projectsCompleted', 'studiesDeveloped', 'licensesSupported',
          'indicatorsConfirmed', 'address', 'generalEmail', 'recruitmentEmail',
          'phonePrimary', 'phoneSecondary', 'whatsappNumber', 'missionText', 'visionText', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'heroTitle', 'heroSubtitle', 'institutionalTitle', 'institutionalDescription',
          'yearsExperience', 'projectsCompleted', 'studiesDeveloped', 'licensesSupported',
          'indicatorsConfirmed', 'address', 'generalEmail', 'recruitmentEmail',
          'phonePrimary', 'phoneSecondary', 'whatsappNumber', 'missionText', 'visionText', 'updatedAt'
        ]) &&
        data.heroTitle is string && data.heroTitle.size() >= 5 && data.heroTitle.size() <= 160 &&
        data.heroSubtitle is string && data.heroSubtitle.size() >= 10 && data.heroSubtitle.size() <= 400 &&
        data.institutionalTitle is string && data.institutionalTitle.size() >= 5 && data.institutionalTitle.size() <= 160 &&
        data.institutionalDescription is string && data.institutionalDescription.size() >= 10 && data.institutionalDescription.size() <= 1200 &&
        data.yearsExperience is string && data.yearsExperience.size() <= 32 &&
        data.projectsCompleted is string && data.projectsCompleted.size() <= 32 &&
        data.studiesDeveloped is string && data.studiesDeveloped.size() <= 32 &&
        data.licensesSupported is string && data.licensesSupported.size() <= 32 &&
        data.indicatorsConfirmed is bool &&
        data.address is string && data.address.size() >= 5 && data.address.size() <= 240 &&
        isValidEmail(data.generalEmail) &&
        isValidEmail(data.recruitmentEmail) &&
        data.phonePrimary is string && data.phonePrimary.size() >= 6 && data.phonePrimary.size() <= 40 &&
        data.phoneSecondary is string && data.phoneSecondary.size() <= 40 &&
        data.whatsappNumber is string && data.whatsappNumber.size() >= 6 && data.whatsappNumber.size() <= 40 &&
        data.missionText is string && data.missionText.size() >= 10 && data.missionText.size() <= 800 &&
        data.visionText is string && data.visionText.size() >= 10 && data.visionText.size() <= 800 &&
        data.updatedAt is timestamp;
    }

    function isValidService(data) {
      return data.keys().hasAll([
          'code', 'slug', 'title', 'shortDescription', 'fullDescription',
          'objectives', 'benefits', 'methodology', 'imageUrl', 'iconName',
          'order', 'active', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'code', 'slug', 'title', 'shortDescription', 'fullDescription',
          'objectives', 'benefits', 'methodology', 'imageUrl', 'iconName',
          'order', 'active', 'createdAt', 'updatedAt'
        ]) &&
        data.code is string && data.code.size() >= 1 && data.code.size() <= 4 &&
        data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 80 && data.slug.matches('^[a-z0-9\\-]+$') &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 140 &&
        data.shortDescription is string && data.shortDescription.size() >= 10 && data.shortDescription.size() <= 400 &&
        data.fullDescription is string && data.fullDescription.size() >= 10 && data.fullDescription.size() <= 3000 &&
        isValidStringList(data.objectives, 10) &&
        isValidStringList(data.benefits, 10) &&
        isValidStringList(data.methodology, 10) &&
        isValidMediaPath(data.imageUrl) &&
        data.iconName is string && data.iconName.size() >= 1 && data.iconName.size() <= 60 &&
        data.order is number && data.order >= 0 && data.order <= 100 &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProject(data) {
      return data.keys().hasAll([
          'title', 'client', 'location', 'sector', 'category',
          'description', 'servicesProvided', 'results', 'imageUrl',
          'confirmed', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title', 'client', 'location', 'sector', 'category',
          'description', 'servicesProvided', 'results', 'imageUrl',
          'confirmed', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 180 &&
        data.client is string && data.client.size() <= 160 &&
        data.location is string && data.location.size() >= 2 && data.location.size() <= 140 &&
        data.sector is string && data.sector.size() >= 2 && data.sector.size() <= 120 &&
        data.category in [
          'Estudos ambientais',
          'Licenciamento ambiental',
          'Auditorias ambientais',
          'Monitorização ambiental',
          'Indústria e energia',
          'Portos e terminais',
          'Gestão de resíduos',
          'Projectos de sustentabilidade'
        ] &&
        data.description is string && data.description.size() >= 10 && data.description.size() <= 3000 &&
        isValidStringList(data.servicesProvided, 10) &&
        data.results is string && data.results.size() <= 1200 &&
        isValidMediaPath(data.imageUrl) &&
        data.confirmed is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidGalleryItem(data) {
      return data.keys().hasAll([
          'title', 'category', 'caption', 'location', 'imageUrl', 'capturedAt', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title', 'category', 'caption', 'location', 'imageUrl', 'capturedAt', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 160 &&
        data.category in [
          'Trabalhos de campo',
          'Visitas técnicas',
          'Campanhas de monitorização',
          'Recolha de amostras',
          'Avaliações ambientais',
          'Actividades industriais',
          'Reuniões técnicas',
          'Projectos concluídos'
        ] &&
        data.caption is string && data.caption.size() >= 3 && data.caption.size() <= 500 &&
        data.location is string && data.location.size() <= 140 &&
        isValidMediaPath(data.imageUrl) &&
        data.capturedAt is string && data.capturedAt.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidNewsArticle(data) {
      return data.keys().hasAll([
          'title', 'slug', 'category', 'summary', 'content', 'imageUrl',
          'publishedDate', 'published', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title', 'slug', 'category', 'summary', 'content', 'imageUrl',
          'publishedDate', 'published', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 4 && data.title.size() <= 200 &&
        data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 120 && data.slug.matches('^[a-z0-9\\-]+$') &&
        data.category in [
          'Notícias institucionais',
          'Novos projectos',
          'Actividades da empresa',
          'Artigos técnicos',
          'Informações ambientais',
          'Legislação e actualizações ambientais',
          'Eventos e formações'
        ] &&
        data.summary is string && data.summary.size() >= 10 && data.summary.size() <= 400 &&
        data.content is string && data.content.size() >= 20 && data.content.size() <= 8000 &&
        isValidMediaPath(data.imageUrl) &&
        data.publishedDate is string && data.publishedDate.size() >= 4 && data.publishedDate.size() <= 40 &&
        data.published is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPartner(data) {
      return data.keys().hasAll([
          'name', 'sector', 'logoUrl', 'websiteUrl', 'authorized', 'order', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'name', 'sector', 'logoUrl', 'websiteUrl', 'authorized', 'order', 'createdAt', 'updatedAt'
        ]) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 140 &&
        data.sector is string && data.sector.size() <= 120 &&
        isValidMediaPath(data.logoUrl) &&
        data.websiteUrl is string && data.websiteUrl.size() <= 300 &&
        data.authorized is bool &&
        data.order is number && data.order >= 0 && data.order <= 200 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProposal(data) {
      return data.keys().hasAll([
          'companyName', 'contactName', 'email', 'phone', 'sector',
          'serviceRequested', 'projectLocation', 'description',
          'attachmentName', 'attachmentUrl', 'status', 'adminNotes',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'companyName', 'contactName', 'email', 'phone', 'sector',
          'serviceRequested', 'projectLocation', 'description',
          'attachmentName', 'attachmentUrl', 'status', 'adminNotes',
          'createdAt', 'updatedAt'
        ]) &&
        data.companyName is string && data.companyName.size() >= 2 && data.companyName.size() <= 160 &&
        data.contactName is string && data.contactName.size() >= 2 && data.contactName.size() <= 140 &&
        isValidEmail(data.email) &&
        data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 40 &&
        data.sector is string && data.sector.size() >= 2 && data.sector.size() <= 120 &&
        data.serviceRequested is string && data.serviceRequested.size() >= 2 && data.serviceRequested.size() <= 160 &&
        data.projectLocation is string && data.projectLocation.size() >= 2 && data.projectLocation.size() <= 160 &&
        data.description is string && data.description.size() >= 10 && data.description.size() <= 3000 &&
        data.attachmentName is string && data.attachmentName.size() <= 200 &&
        data.attachmentUrl is string && data.attachmentUrl.size() <= 500 &&
        data.status in ['novo', 'em_analise', 'respondido', 'arquivado'] &&
        data.adminNotes is string && data.adminNotes.size() <= 1500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidContact(data) {
      return data.keys().hasAll([
          'name', 'email', 'phone', 'subject', 'message', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'name', 'email', 'phone', 'subject', 'message', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 140 &&
        isValidEmail(data.email) &&
        data.phone is string && data.phone.size() <= 40 &&
        data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 180 &&
        data.message is string && data.message.size() >= 5 && data.message.size() <= 3000 &&
        data.status in ['novo', 'lido', 'respondido'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMediaAsset(data) {
      return data.keys().hasAll([
          'title', 'type', 'category', 'url', 'fileName', 'mimeType', 'sizeLabel', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title', 'type', 'category', 'url', 'fileName', 'mimeType', 'sizeLabel', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 160 &&
        data.type in ['image', 'document'] &&
        data.category is string && data.category.size() >= 2 && data.category.size() <= 80 &&
        isValidMediaPath(data.url) &&
        data.fileName is string && data.fileName.size() <= 180 &&
        data.mimeType is string && data.mimeType.size() <= 80 &&
        data.sizeLabel is string && data.sizeLabel.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'name', 'role', 'createdAt']) &&
        data.keys().hasOnly(['email', 'name', 'role', 'createdAt']) &&
        isValidEmail(data.email) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
        data.role == 'admin' &&
        data.createdAt is timestamp;
    }

    function isValidNewsletterSubscriber(data) {
      return data.keys().hasAll([
          'email', 'name', 'topics', 'status', 'sourcePage', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'email', 'name', 'topics', 'status', 'sourcePage', 'createdAt', 'updatedAt'
        ]) &&
        isValidEmail(data.email) &&
        data.name is string && data.name.size() <= 120 &&
        data.topics is list && data.topics.size() >= 1 && data.topics.size() <= 3 &&
        data.topics[0] is string &&
        data.topics.hasOnly(['Legislação Ambiental', 'Notícias da Empresa', 'Artigos Técnicos']) &&
        data.status in ['ativo', 'cancelado'] &&
        data.sourcePage is string && data.sourcePage.size() >= 1 && data.sourcePage.size() <= 60 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTestimonial(data) {
      return data.keys().hasAll([
          'authorName', 'organization', 'role', 'rating', 'comment', 'published', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'authorName', 'organization', 'role', 'rating', 'comment', 'published', 'createdAt', 'updatedAt'
        ]) &&
        data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 120 &&
        data.organization is string && data.organization.size() <= 140 &&
        data.role is string && data.role.size() <= 120 &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.comment is string && data.comment.size() >= 8 && data.comment.size() <= 1500 &&
        data.published is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    // Connection test doc
    match /test/connection {
      allow get: if true;
    }

    // Site Settings (Public read, Admin write)
    match /siteSettings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if false;
      allow create: if isAdmin() && isValidId(settingId) && isValidSiteSettings(incoming()) &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(settingId) && isValidSiteSettings(incoming()) &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // Services (Public read, Admin write)
    match /services/{serviceId} {
      allow get: if isValidId(serviceId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(serviceId) && isValidService(incoming()) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(serviceId) && isValidService(incoming()) &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'code', 'slug', 'title', 'shortDescription', 'fullDescription',
          'objectives', 'benefits', 'methodology', 'imageUrl', 'iconName',
          'order', 'active', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(serviceId);
    }

    // Projects (Public read only confirmed projects, Admin read/write all)
    match /projects/{projectId} {
      allow get: if isValidId(projectId) && (existing().confirmed == true || isAdmin());
      allow list: if resource.data.confirmed == true || isBootstrappedAdmin();
      allow create: if isAdmin() && isValidId(projectId) && isValidProject(incoming()) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(projectId) && isValidProject(incoming()) &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'client', 'location', 'sector', 'category',
          'description', 'servicesProvided', 'results', 'imageUrl', 'confirmed', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(projectId);
    }

    // Gallery (Public read, Admin write)
    match /gallery/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(itemId) && isValidGalleryItem(incoming()) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(itemId) && isValidGalleryItem(incoming()) &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'category', 'caption', 'location', 'imageUrl', 'capturedAt', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(itemId);
    }

    // News & Publications (Public read published only, Admin read/write all)
    match /news/{articleId} {
      allow get: if isValidId(articleId) && (existing().published == true || isAdmin());
      allow list: if resource.data.published == true || isBootstrappedAdmin();
      allow create: if isAdmin() && isValidId(articleId) && isValidNewsArticle(incoming()) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(articleId) && isValidNewsArticle(incoming()) &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'slug', 'category', 'summary', 'content', 'imageUrl', 'publishedDate', 'published', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(articleId);
    }

    // Partners (Public read authorized only, Admin read/write all)
    match /partners/{partnerId} {
      allow get: if isValidId(partnerId) && (existing().authorized == true || isAdmin());
      allow list: if resource.data.authorized == true || isBootstrappedAdmin();
      allow create: if isAdmin() && isValidId(partnerId) && isValidPartner(incoming()) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(partnerId) && isValidPartner(incoming()) &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'sector', 'logoUrl', 'websiteUrl', 'authorized', 'order', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(partnerId);
    }

    // Proposal Requests (Public create with strict schema; PII read/manage Admin-only)
    match /proposals/{proposalId} {
      allow get: if isValidId(proposalId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(proposalId) && isValidProposal(incoming()) &&
        incoming().status == 'novo' &&
        incoming().adminNotes == '' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(proposalId) && isValidProposal(incoming()) &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNotes', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(proposalId);
    }

    // Contact Messages (Public create with strict schema; PII read/manage Admin-only)
    match /contacts/{contactId} {
      allow get: if isValidId(contactId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(contactId) && isValidContact(incoming()) &&
        incoming().status == 'novo' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(contactId) && isValidContact(incoming()) &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(contactId);
    }

    // Media & Documents (Public read for brochures/assets, Admin write)
    match /media/{mediaId} {
      allow get: if isValidId(mediaId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(mediaId) && isValidMediaAsset(incoming()) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(mediaId) && isValidMediaAsset(incoming()) &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'type', 'category', 'url', 'fileName', 'mimeType', 'sizeLabel', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(mediaId);
    }

    // Newsletter Subscribers (Public create with strict schema; PII read/manage Admin-only)
    match /newsletterSubscribers/{subscriberId} {
      allow get: if isValidId(subscriberId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(subscriberId) && isValidNewsletterSubscriber(incoming()) &&
        incoming().status == 'ativo' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(subscriberId) && isValidNewsletterSubscriber(incoming()) &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(subscriberId);
    }

    // Testimonials & Witness Feedback (Public create & read published; Admin moderate/delete)
    match /testimonials/{testimonialId} {
      allow get: if isValidId(testimonialId) && (existing().published == true || isAdmin());
      allow list: if resource.data.published == true || isBootstrappedAdmin();
      allow create: if isValidId(testimonialId) && isValidTestimonial(incoming()) &&
        incoming().published == true &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(testimonialId) && isValidTestimonial(incoming()) &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['published', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(testimonialId);
    }

    // Admins (Admin-only)
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isBootstrappedAdmin() && isValidId(adminId) && isValidAdminUser(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isBootstrappedAdmin() && isValidId(adminId);
    }
  }
}
